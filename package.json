{
  "name": "jevtrace",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-based offline analysis of coding agent traces",
  "type": "module",
  "bin": {
    "jevtrace": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixtures": "tsx scripts/create-fixtures.ts",
    "benchmark": "tsx src/cli.ts benchmark benchmark --judge rules --output reports/rules.json",
    "experiments": "tsx scripts/run-experiments.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0",
    "commander": "^14.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
